# Copy this file to .env (which is gitignored) and fill in real values.
# .env must NEVER be committed — it holds live credentials.

# --- LLM judge provider (LLMgateway.io, OpenAI-compatible) ---
# devpass로 발급한 키를 아래에 채우세요. self-host/custom 게이트웨이면 BASE_URL을 해당 주소로 교체.
LLM_GATEWAY_BASE_URL=https://api.llmgateway.io/v1
LLM_GATEWAY_API_KEY=your-llmgateway-api-key-here
# 선택: judge 모델(비-Qwen). /v1/models로 확인 후 provider/model 형식 권장. 미설정 시 코드 기본값 사용.
# LLM_JUDGE_MODEL=

# --- Dataset location (optional) ---
# The reference dataset is the licensed NIA "Multi-view CCTV daily-life safety"
# (다각도 CCTV 생활안전) set from AI Hub (https://aihub.or.kr). After extracting it,
# point the builder at it with ONE of the following, or pass explicit
# --train-labels/--validation-labels to `python -m mvevirag.dataset_builder`:
#   MVEVIRAG_DATASET_ROOT=/absolute/path/to/extract/3.개방데이터/1.데이터
#   MVEVIRAG_DATASET_SUBPATH=resources/21.다각도 CCTV 생활안전 데이터/3.개방데이터/1.데이터

# --- Remote GPU / host config ---
# SSH aliases, IP addresses, and credentials for any remote GPU box or Jetson
# device are environment-specific and must NOT be committed. Keep them in your
# local ~/.ssh/config and your private .env only.
